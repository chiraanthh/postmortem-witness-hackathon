# Frontend environment (Vite). Copy to `.env` for local dev.
#
# Live WebSocket is the default. Set VITE_MOCK=true only for offline UI work
# against the fixture (numbers will be synthetic — never demo them as measured).
VITE_MOCK=false

# Playback speed for the mock incident. Only used when VITE_MOCK=true.
VITE_MOCK_SPEED=1

# Optional absolute WS URL. Leave unset in production (same-origin wss://).
# Local Vite-without-proxy example:
# VITE_WS_URL=ws://127.0.0.1:8000/ws
