# Frontend environment (Vite). Copy to `.env` for local dev.
#
# The mock event system is the default and the permanent fallback for the live
# demo. It is ON unless you explicitly set VITE_MOCK=false.
VITE_MOCK=true

# Playback speed for the mock incident. 1 = real 90s wall-clock. Higher is
# faster. Only used when VITE_MOCK is not false.
VITE_MOCK_SPEED=1

# Future live feed. The WebSocket client is NOT built yet — this is only the
# seam the mock and the real transport will share.
# VITE_WS_URL=ws://localhost:8000/ws
