      "index": 41,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 229565,
      "end_ms": 232296,
      "duration_ms": 2731,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Ticket rate has slowed too. Nothing new in the last two minutes."
    },
    {
      "index": 42,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 236065,
      "end_ms": 240284,
      "duration_ms": 4219,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Error rate is basically back to baseline now. We're under one percent."
    },
    {
      "index": 43,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 243565,
      "end_ms": 249458,
      "duration_ms": 5893,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "Yeah, it was the deploy. The rollback fixed it. I'll revert the retry change properly and put a test around it."
    },
    {
      "index": 44,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 252565,
      "end_ms": 255552,
      "duration_ms": 2987,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Good. Anyone object to calling this resolved?"
    },
    {
      "index": 45,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 257565,
      "end_ms": 259788,
      "duration_ms": 2223,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "No, looks clean from here."
    },
    {
      "index": 46,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 259388,
      "end_ms": 260583,
      "duration_ms": 1195,
      "overlap": true,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Support side is quiet."
    },
    {
      "index": 47,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 262888,
      "end_ms": 269885,
      "duration_ms": 6997,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Okay. Declaring this resolved at three fifteen. Thanks, everyone. We'll do a proper postmortem tomorrow."
