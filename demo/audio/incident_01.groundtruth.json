  "lines": [
    {
      "index": 0,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 0,
      "end_ms": 3413,
      "duration_ms": 3413,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Okay, everyone on? Let's start. What are we looking at?"
    },
    {
      "index": 1,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 4500,
      "end_ms": 7999,
      "duration_ms": 3499,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Checkout is throwing five oh twos. The support queue is filling up fast."
    },
    {
      "index": 2,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 9000,
      "end_ms": 13352,
      "duration_ms": 4352,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "We're seeing it on roughly thirty percent of payment attempts. First ticket came in around two twenty."
    },
    {
      "index": 3,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 16800,
      "end_ms": 19616,
      "duration_ms": 2816,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Two twenty. So about forty minutes ago."
    },
    {
      "index": 4,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 20116,
      "end_ms": 27659,
      "duration_ms": 7543,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "I'm seeing the error rate spike on the payment service dashboard. It's not the whole fleet, it's the payment workers specifically."
    },
    {
      "index": 5,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 29916,
      "end_ms": 35719,
      "duration_ms": 5803,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Right. Priya, can you take infra? Rohan, keep tracking customer impact."
    },
    {
      "index": 6,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 35319,
      "end_ms": 36195,
      "duration_ms": 876,
      "overlap": true,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Yeah, on it."
    },
    {
      "index": 7,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 35795,
      "end_ms": 36648,
      "duration_ms": 853,
      "overlap": true,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Will do."
    },
    {
      "index": 8,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 38395,
      "end_ms": 43958,
      "duration_ms": 5563,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "First thing I'd check is DNS. We had a resolver issue last month that looked a lot like this."
    },
    {
      "index": 9,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 43558,
      "end_ms": 48983,
      "duration_ms": 5425,
      "overlap": true,
      "voice": "simran",
      "pace": 1.05,
      "text": "Could be the connection pool. If we're exhausting database connections we'd see exactly this pattern."
    },
    {
      "index": 10,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 50358,
      "end_ms": 54881,
      "duration_ms": 4523,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Should we check the payment provider's status page? If it's upstream there's nothing we can do anyway."
    },
    {
      "index": 11,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 57458,
      "end_ms": 63517,
      "duration_ms": 6059,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "All three. Priya, DNS and the provider. Disha, look at the pool."
    },
    {
      "index": 12,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 64017,
      "end_ms": 66174,
      "duration_ms": 2157,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "Okay, pulling up the pool metrics now."
    },
    {
      "index": 13,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 65774,
      "end_ms": 67388,
      "duration_ms": 1614,
      "overlap": true,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Give me a minute on DNS."
    },
    {
      "index": 14,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 72274,
      "end_ms": 79186,
      "duration_ms": 6912,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "DNS is fine. I checked the resolver, queries are resolving normally, latency is flat. It's not that."
    },
    {
      "index": 15,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 79774,
      "end_ms": 81822,
      "duration_ms": 2048,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Good, that's one down."
    },
    {
      "index": 16,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 82774,
      "end_ms": 85590,
      "duration_ms": 2816,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Ticket count is at about two hundred now. Still climbing."
    },
    {
      "index": 17,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 88274,
      "end_ms": 93618,
      "duration_ms": 5344,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "Pool looks healthy, actually. We're nowhere near the connection limit, utilisation is around forty percent."
    },
    {
      "index": 18,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 95674,
      "end_ms": 97523,
      "duration_ms": 1849,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "So I don't think it's the pool either."
    },
    {
      "index": 19,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 98223,
      "end_ms": 101793,
      "duration_ms": 3570,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "So it's probably not the cache, I'd say we drop that one."
    },
    {
      "index": 20,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 104274,
      "end_ms": 110280,
      "duration_ms": 6006,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "And the provider status page is green. All their systems are operational. It's not upstream."
    },
    {
      "index": 21,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 111274,
      "end_ms": 115029,
      "duration_ms": 3755,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Okay, so it's us. Something changed on our side."
    },
    {
      "index": 22,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 116774,
      "end_ms": 119249,
      "duration_ms": 2475,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Did anything ship today? Any deploys?"
    },
    {
      "index": 23,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 120774,
      "end_ms": 125636,
      "duration_ms": 4862,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "There was a deploy, but it went out at one forty. That's forty minutes before any of this started."
    },
    {
      "index": 24,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 127574,
      "end_ms": 131780,
      "duration_ms": 4206,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "It passed all the tests, and we've had clean deploys on that pipeline for weeks."
    },
    {
      "index": 25,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 131380,
      "end_ms": 134281,
      "duration_ms": 2901,
      "overlap": true,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Forty minutes is not that long. What was in it?"
    },
    {
      "index": 26,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 136380,
      "end_ms": 140992,
      "duration_ms": 4612,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "A retry logic change on the payment worker. Backoff configuration, mostly."
    },
    {
      "index": 27,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 142380,
      "end_ms": 148465,
      "duration_ms": 6085,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Hang on. If the retry logic changed, and we're seeing timeouts, those could absolutely be related."
    },
    {
      "index": 28,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 148065,
      "end_ms": 148858,
      "duration_ms": 793,
      "overlap": true,
      "voice": "simran",
      "pace": 1.05,
      "text": "Hmm."
    },
    {
      "index": 29,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 150065,
      "end_ms": 157116,
      "duration_ms": 7051,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "Actually, yeah. If the backoff is too aggressive we'd be hammering the provider and hitting their rate limit. That would look exactly like this."
    },
    {
      "index": 30,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 160765,
      "end_ms": 163426,
      "duration_ms": 2661,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "It lines up. I think it's the deploy."
    },
    {
      "index": 31,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 165065,
      "end_ms": 167113,
      "duration_ms": 2048,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Okay, that's our leading theory."
    },
    {
      "index": 32,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 167800,
      "end_ms": 174355,
      "duration_ms": 6555,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Hold on though — looking at the timeouts again, the pool has to be under pressure if we're seeing connection failures like this."
    },
    {
      "index": 33,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 175065,
      "end_ms": 179844,
      "duration_ms": 4779,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Also, unrelated, but the TLS certificate on the gateway expires in two days. Should someone be looking at that?"
    },
    {
      "index": 34,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 184565,
      "end_ms": 186869,
      "duration_ms": 2304,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Disha, how fast can you roll back?"
    },
    {
      "index": 35,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 189065,
      "end_ms": 192052,
      "duration_ms": 2987,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "Five minutes, maybe. The previous build is still in the registry."
    },
    {
      "index": 36,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 195565,
      "end_ms": 197089,
      "duration_ms": 1524,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "I'll roll back the deploy now."
    },
    {
      "index": 37,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 199565,
      "end_ms": 202347,
      "duration_ms": 2782,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "I'll watch the error rate and tell you when it drops."
    },
    {
      "index": 38,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 204565,
      "end_ms": 211733,
      "duration_ms": 7168,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Someone needs to check the rate limit configuration on the provider side as well. We should know what our actual ceiling is."
    },
    {
      "index": 39,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 214565,
      "end_ms": 218149,
      "duration_ms": 3584,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Rohan, can you draft a status update for customers?"
    },
    {
      "index": 40,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 219565,
      "end_ms": 221869,
      "duration_ms": 2304,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Yeah, I'll get something out in the next ten minutes."
    },
    {
      "index": 41,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 226065,
      "end_ms": 229349,
      "duration_ms": 3284,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Rollback is going out. I can see the new pods coming up."
    },
    {
      "index": 42,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 234065,
      "end_ms": 237201,
      "duration_ms": 3136,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Error rate is dropping. We're down to about twelve percent."
    },
    {
      "index": 43,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 240565,
      "end_ms": 243296,
      "duration_ms": 2731,
      "overlap": false,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Ticket rate has slowed too. Nothing new in the last two minutes."
    },
    {
      "index": 44,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 247065,
      "end_ms": 251284,
      "duration_ms": 4219,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "Error rate is basically back to baseline now. We're under one percent."
    },
    {
      "index": 45,
      "speaker": "B",
      "speaker_name": "Disha",
      "start_ms": 254565,
      "end_ms": 260458,
      "duration_ms": 5893,
      "overlap": false,
      "voice": "simran",
      "pace": 1.05,
      "text": "Yeah, it was the deploy. The rollback fixed it. I'll revert the retry change properly and put a test around it."
    },
    {
      "index": 46,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 263565,
      "end_ms": 266552,
      "duration_ms": 2987,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Good. Anyone object to calling this resolved?"
    },
    {
      "index": 47,
      "speaker": "C",
      "speaker_name": "Priya",
      "start_ms": 268565,
      "end_ms": 270788,
      "duration_ms": 2223,
      "overlap": false,
      "voice": "ritu",
      "pace": 0.95,
      "text": "No, looks clean from here."
    },
    {
      "index": 48,
      "speaker": "D",
      "speaker_name": "Rohan",
      "start_ms": 270388,
      "end_ms": 271583,
      "duration_ms": 1195,
      "overlap": true,
      "voice": "shubh",
      "pace": 1.0,
      "text": "Support side is quiet."
    },
    {
      "index": 49,
      "speaker": "A",
      "speaker_name": "Arjun",
      "start_ms": 273888,
      "end_ms": 280885,
      "duration_ms": 6997,
      "overlap": false,
      "voice": "aditya",
      "pace": 1.0,
      "text": "Okay. Declaring this resolved at three fifteen. Thanks, everyone. We'll do a proper postmortem tomorrow."
    }
  ]
