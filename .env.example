EXTRACTION_PROVIDER=anthropic
EXTRACTION_MODEL=claude-haiku-4-5-20251001
# EXTRACTION_PROVIDER=assemblyai_gateway
# EXTRACTION_MODEL=claude-sonnet-4-6
# LLM_GATEWAY_REGION=us
# CLEANUP_ENABLED=false

# Local dev / test-suite / legacy single-hub /incident/* routes only.
# The portal's live pipeline and upload run on each visitor's own
# bring-your-own keys (backend/byok.py) and never read these.
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=

# Concurrent live-pipeline seats (replay/mock uncapped). Default 2.
# LIVE_PIPELINE_CAP=2
# LIVE_SLOT_IDLE_TIMEOUT_S=45
